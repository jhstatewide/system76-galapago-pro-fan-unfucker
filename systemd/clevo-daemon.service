[Unit]
Description=Galago Pro Fan Control Daemon
After=multi-user.target
Wants=multi-user.target

[Service]
Type=forking
User=root
Group=root
ExecStart=/usr/local/bin/clevo-daemon --target-temp 50 --adaptive-pid 1 --max-increase-rate 10 --max-decrease-rate 20 --quiet
Restart=on-failure
RestartSec=5

# Low CPU priority
Nice=19
IOSchedulingClass=3
IOSchedulingPriority=7

# Capabilities for EC access
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
#ReadWritePaths=/sys/kernel/debug/ec

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=galago-pro-fan-daemon

[Install]
WantedBy=multi-user.target 
