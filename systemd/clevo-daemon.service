[Unit]
Description=Galago Pro Fan Control Daemon
After=multi-user.target dbus.service
Wants=multi-user.target
Requires=dbus.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/clevo-daemon --debug --target 55
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=5
KillMode=mixed
KillSignal=SIGTERM

# Low CPU priority
Nice=19
IOSchedulingClass=3
IOSchedulingPriority=7

# Capabilities for EC access
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
#ReadWritePaths=/sys/kernel/debug/ec

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=galago-pro-fan-daemon

[Install]
WantedBy=multi-user.target 
